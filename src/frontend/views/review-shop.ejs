<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xem Đánh Giá Sản Phẩm</title>
    <link rel="stylesheet" href="/styles/reviews.css">
    <link rel="shortcut icon" href="/static/shopee.svg" type="image/x-icon">
    <link rel="stylesheet" href="/styles/normalize.min.css">
    <link rel="stylesheet" href="/styles/bootstrap.css">
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/grid.css">
    <link rel="stylesheet" href="/styles/responsive.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap&subset=vietnamese" rel="stylesheet">
    <script src="/scripts/jquery.js"></script>
    <script src="/scripts/bootstrap.js"></script>
    <style>
        .loading-spinner {
            display: none;
            text-align: center;
            padding: 20px;
        }
        
        .loading-spinner.show {
            display: block;
        }
        
        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3498db;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 10px;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .no-more-reviews {
            text-align: center;
            padding: 20px;
            color: #666;
            font-style: italic;
            border-top: 1px solid #eee;
            margin-top: 20px;
            display: none;
        }
        
        .no-more-reviews.show {
            display: block;
        }

        /* Styles for the reply popup */
        .reply-popup {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.4);
        }

        .reply-popup-content {
            background-color: #fefefe;
            margin: 15% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 80%;
            max-width: 500px;
            border-radius: 8px;
        }

        .close-popup {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
        }

        .close-popup:hover,
        .close-popup:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }
    </style>
</head>

<body>
    <div class="container">
        <%- include('boilerplates/reviews-header') %>
        
        <div class="reviews-container" id="reviews-container">
            <% reviews.forEach(review => { %>
                <%- include('boilerplates/reviews-item', { review: review }) %>
            <% }) %>
        </div>
        
        <!-- Loading spinner -->
        <div class="loading-spinner" id="loading-spinner">
            <div class="spinner"></div>
            <p>Đang tải thêm đánh giá...</p>
        </div>
        
        <!-- No more reviews message -->
        <div class="no-more-reviews" id="no-more-reviews">
            Không còn bình luận!
        </div>
    </div>

    <!-- Reply Popup Form -->
    <div id="reply-popup" class="reply-popup">
        <div class="reply-popup-content">
            <span class="close-popup">&times;</span>
            <h2>Phản hồi đánh giá</h2>
            <form id="reply-form">
                <input type="hidden" id="reply-product-id" name="productId">
                <input type="hidden" id="reply-review-id" name="reviewId">
                <textarea id="reply-content" name="reply_content" rows="4" style="width: 100%;" placeholder="Nhập phản hồi của bạn..." required></textarea>
                <button type="submit">Gửi phản hồi</button>
            </form>
        </div>
    </div>

    <%- include('boilerplates/footer') %>

    <script>
        let isLoading = false;
        let hasMore = <%= hasMore %>;
        let nextPage = '<%= nextPage %>';
        let currentFilter = 'all'; 
        const productId = '<%= productId %>';

        function createReviewHTML(review) {
            let starsHTML = '';
            for (let i = 1; i <= 5; i++) {
                starsHTML += `<span class="star ${i <= review.rating ? 'filled' : ''}">★</span>`;
            }
            
            let imagesHTML = '';
            if (review.images && review.images.length > 0) {
                imagesHTML = '<div class="review-images">';
                review.images.forEach((image, index) => {
                    imagesHTML += `
                        <div class="image-container">
                            <img src="${image}" alt="Review image ${index + 1}"
                                 onload="this.nextElementSibling.style.display='none';" 
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="image-placeholder">
                                ${index === 0 ? '📷' : '🖼️'}
                            </div>
                        </div>
                    `;
                });
                imagesHTML += '</div>';
            }
            
            let responseHTML = '';
            if (review.response) {
                responseHTML = `
                    <div class="seller-response">
                        <div class="response-header">${review.response.title}</div>
                        <div class="response-content">${review.response.content}</div>
                    </div>
                `;
            }

            let replyButtonHTML = '';
            if (!review.response) {
                replyButtonHTML = `<button class="reply-to-review-btn" data-product-id="${review.masp}" data-review-id="${review.mauser}">Phản hồi đánh giá của khách hàng</button>`;
            }
            
            return `
                <div class="review-item" data-review-item-id="${review.mauser}">
                    <div class="review-header">
                        <div class="user-avatar">
                            <img src="/images/default-avatar.png" alt="Avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="avatar-placeholder">
                                ${review.username.charAt(0).toUpperCase()}
                            </div>
                        </div>
                        
                        <div class="review-info">
                            <div class="username">${review.username}</div>
                            <div class="review-meta">
                                <div class="stars">${starsHTML}</div>
                                <div class="review-date">${review.date}</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="review-content">
                        <div class="review-title">
                            <div><strong>Chất lượng sản phẩm:</strong> ${review.chatluong}</div>
                            <div><strong>Chất lượng đúng với mô tả:</strong> ${review.mota_dung}</div>
                            <div><strong>Phân loại sản phẩm:</strong> ${review.phanloai}</div>
                        </div>
                        <div class="review-text">${review.content}</div>
                        
                        ${imagesHTML}
                        <div class="seller-response-container">
                            ${responseHTML}
                        </div>
                        ${replyButtonHTML}
                    </div>
                </div>
            `;
        }
        
        async function loadReviews(filter = 'all', pageState = null, append = false) {
            if (isLoading) return;
            
            isLoading = true;
            document.getElementById('loading-spinner').classList.add('show');
            
            try {
                let url = `/api/reviews/${productId}?filter=${filter}`;
                if (pageState) {
                    url += `&pageState=${pageState}`;
                }
                
                const response = await fetch(url);
                const data = await response.json();
                
                if (data.reviews) {
                    const reviewsContainer = document.getElementById('reviews-container');
                    
                    if (!append) {
                        reviewsContainer.innerHTML = '';
                        document.getElementById('no-more-reviews').classList.remove('show');
                    }
                    
                    data.reviews.forEach(review => {
                        reviewsContainer.insertAdjacentHTML('beforeend', createReviewHTML(review));
                    });
                    
                    nextPage = data.nextPage;
                    hasMore = data.hasMore;
                    currentFilter = filter;
                    
                    if (!hasMore) {
                        document.getElementById('no-more-reviews').classList.add('show');
                    }
                }
            } catch (error) {
                console.error('Error loading reviews:', error);
            } finally {
                isLoading = false;
                document.getElementById('loading-spinner').classList.remove('show');
            }
        }
        
        async function loadMoreReviews() {
            if (isLoading || !hasMore) return;
            
            await loadReviews(currentFilter, nextPage, true);
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelectorAll('.filter-btn');
            
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    
                    this.classList.add('active');
                    
                    let filter = this.getAttribute('data-filter');
                    
                    if (!filter) {
                        const buttonText = this.textContent.toLowerCase();
                        
                        if (buttonText.includes('5 sao')) {
                            filter = 'rating-5';
                        } else if (buttonText.includes('4 sao')) {
                            filter = 'rating-4';
                        } else if (buttonText.includes('3 sao')) {
                            filter = 'rating-3';
                        } else if (buttonText.includes('2 sao')) {
                            filter = 'rating-2';
                        } else if (buttonText.includes('1 sao')) {
                            filter = 'rating-1';
                        } else if (buttonText.includes('hình ảnh') || buttonText.includes('video')) {
                            filter = 'images';
                        } else {
                            filter = 'all';
                        }
                    }
                    
                    loadReviews(filter);
                });
            });

            // Reply popup logic
            const popup = document.getElementById('reply-popup');
            const closeBtn = document.querySelector('.close-popup');
            const replyForm = document.getElementById('reply-form');
            const reviewsContainer = document.getElementById('reviews-container');

            reviewsContainer.addEventListener('click', function(e) {
                if (e.target.classList.contains('reply-to-review-btn')) {
                    const productId = e.target.dataset.productId;
                    const reviewId = e.target.dataset.reviewId;

                    document.getElementById('reply-product-id').value = productId;
                    document.getElementById('reply-review-id').value = reviewId;
                    popup.style.display = 'block';
                }
            });

            closeBtn.onclick = function() {
                popup.style.display = 'none';
            }

            window.onclick = function(event) {
                if (event.target == popup) {
                    popup.style.display = 'none';
                }
            }

            replyForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const productId = document.getElementById('reply-product-id').value;
                const reviewId = document.getElementById('reply-review-id').value;
                const replyContent = document.getElementById('reply-content').value;

                try {
                    const response = await fetch(`/product/${productId}/reviews/${reviewId}/reply`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ reply_content: replyContent })
                    });

                    if (response.ok) {
                        popup.style.display = 'none';
                        replyForm.reset();

                        // Update the UI
                        const reviewItem = document.querySelector(`.review-item[data-review-item-id="${reviewId}"]`);
                        if(reviewItem) {
                            const responseContainer = reviewItem.querySelector('.seller-response-container');
                            responseContainer.innerHTML = `
                                <div class="seller-response">
                                    <div class="response-header">Phản Hồi Của Người Bán</div>
                                    <div class="response-content">${replyContent}</div>
                                </div>
                            `;
                            const replyButton = reviewItem.querySelector('.reply-to-review-btn');
                            if(replyButton) {
                                replyButton.remove();
                            }
                        }

                    } else {
                        alert('Gửi phản hồi thất bại!');
                    }
                } catch (error) {
                    console.error('Error submitting reply:', error);
                    alert('Đã có lỗi xảy ra.');
                }
            });
        });
        
        window.addEventListener('scroll', function() {
            if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 1000) {
                loadMoreReviews();
            }
        });
        
        if (!hasMore) {
            document.getElementById('no-more-reviews').classList.add('show');
        }
    </script>
    
</body>
</html>
