<!-- views/boilerplates/products.ejs -->
<div class="app__container">
    <div class="grid wide">
        <div class="row sm-gutter app_content">
            <!-- Category left bar -->
            <div class="col l-2 m-0 c-0">
                <nav class="category">
                    <h3 class="category__heading">Danh mục</h3>
                    <ul class="category-list">
                        <!-- Categories will be loaded dynamically -->
                        <li class="category-item category-item--active">
                            <a href="#" class="category-item__link" data-category="Best Seller">Best Seller</a>
                        </li>
                    </ul>
                </nav>
            </div>

            <!-- Product -->
            <div class="col l-10 m-12 c-12">
                <!-- Filter bar -->
                <div class="home-filter hide-on-mobile-tablet">
                    <span class="home-filter__label">Sắp xếp theo</span>
                    <button class="home-filter__btn btn btn--primary">Phổ biến</button>
                    <button class="home-filter__btn btn">Mới nhất</button>
                    <button class="home-filter__btn btn">Bán chạy</button>

                    <div class="select-input">
                        <span class="select-input__label">Giá</span>
                        <i class="select-input__icon fa-solid fa-angle-down"></i>
                        
                        <!-- List options -->
                        <ul class="select-input__list">
                            <li class="select-input__item">
                                <a href="#" class="select-input__link">
                                    Giá: Thấp đến Cao
                                </a>
                            </li>
                            <li class="select-input__item">
                                <a href="#" class="select-input__link">
                                    Giá: Cao đến Thấp
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="home-filter__page">
                        <span class="home-filter__page-num">
                            <span class="home-filter__page-current">1</span>/<span class="home-filter__page-total">1</span>
                        </span>
                        <div class="home-filter__page-control">
                            <a href="#" class="home-filter__page-btn home-filter__page-btn-disabled">
                                <i class="home-filter__page-icon fa-solid fa-angle-left"></i>
                            </a>
                            <a href="#" class="home-filter__page-btn">
                                <i class="home-filter__page-icon fa-solid fa-angle-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Mobile Category -->
                <nav class="mobile-category">
                    <ul class="mobile-category__list">
                        <!-- Mobile categories will be populated dynamically -->
                    </ul>
                </nav>

                <!-- Product list -->
                <div class="home-product">
                    <div class="row sm-gutter">
                        <!-- Products will be loaded dynamically -->
                        <div class="col l-12">
                            <div class="text-center" style="padding: 50px;">
                                <div class="loading-spinner">Đang tải sản phẩm...</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pagination -->
                <ul class="pagination home-product__pagination">
                    <!-- Pagination will be rendered dynamically -->
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Load products script -->
<script src="/scripts/products.js"></script>

<style>
/* Additional styles for dynamic content */
.loading-spinner {
    font-size: 16px;
    color: #666;
}

.select-input {
    position: relative;
    cursor: pointer;
}

.select-input__list {
    position: absolute;
    top: 100%;
    left: 0;
    background: white;
    border: 1px solid #ddd;
    border-radius: 4px;
    min-width: 200px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    z-index: 10;
    display: none;
}

.select-input--active .select-input__list {
    display: block;
}

.select-input__item {
    list-style: none;
}

.select-input__link {
    display: block;
    padding: 10px 15px;
    text-decoration: none;
    color: #333;
    border-bottom: 1px solid #eee;
}

.select-input__link:hover {
    background-color: #f5f5f5;
}

.home-product-item__like--liked .home-product-item__like-icon-fill {
    color: #f53d2d;
}

.home-product-item__like--liked .home-product-item__like-icon-empty {
    display: none;
}

.home-product-item__like:not(.home-product-item__like--liked) .home-product-item__like-icon-fill {
    display: none;
}

.home-product-item__out-of-stock {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0,0,0,0.8);
    color: white;
    padding: 5px 10px;
    border-radius: 3px;
    font-size: 12px;
}

.pagination-item__link--disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.category-item--active {
    background-color: #f8f9fa;
}

.category-item--active .category-item__link {
    color: #f53d2d;
    font-weight: bold;
}

@media (max-width: 740px) {
    .select-input__list {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 90%;
        max-width: 300px;
    }
}
</style>