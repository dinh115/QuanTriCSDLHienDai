<h2>🛒 Giỏ hàng của bạn</h2>

<ul>
  <% cart.items.forEach(item => { %>
    <li>
      <input type="checkbox" <% if (lastAddedId === item.id) { %>checked<% } %> />
      <strong>Sản phẩm:</strong> <%= item.productId %> — Số lượng: <%= item.quantity %>
    </li>
  <% }) %>
</ul>

<a href="/">⬅️ Tiếp tục mua hàng</a>
