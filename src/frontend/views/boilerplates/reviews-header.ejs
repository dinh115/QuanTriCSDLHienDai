<div class="reviews-header">
    <h2 class="header-title">ĐÁNH GIÁ SẢN PHẨM</h2>

    <div class="rating-overview">
        <div class="overall-rating">
            <span class="rating-score">4.8</span>
            <!-- Giá trị mặc định, sẽ được cập nhật bằng JS -->
            <span class="rating-text">trên 5</span>
        </div>

        <div class="stars-display">
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
        </div>
    </div>

    <div class="rating-filters">
        <button class="filter-btn active" data-filter="all">Tất Cả</button>
        <button class="filter-btn" data-filter="rating-5">5 Sao</button>
        <button class="filter-btn" data-filter="rating-4">4 Sao</button>
        <button class="filter-btn" data-filter="rating-3">3 Sao</button>
        <button class="filter-btn" data-filter="rating-2">2 Sao</button>
        <button class="filter-btn" data-filter="rating-1">1 Sao</button>
        <button class="filter-btn" data-filter="images">Có Hình Ảnh /
            Video</button>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Bắt đầu tải dữ liệu từ API'); // Kiểm tra xem mã có chạy không
        const productId = '<%= productId %>';
        fetch(`http://localhost:3009/product/${productId}/reviews/summary`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                console.log('API Data:', data); // Kiểm tra dữ liệu từ API

                // Cập nhật số lượng đánh giá cho các nút lọc
                document.querySelector('.filter-btn[data-filter="all"]').textContent = `Tất Cả (${data.total_reviews || 0})`;
                document.querySelector('.filter-btn[data-filter="rating-5"]').textContent = `5 Sao (${data.rating_5 || 0})`;
                document.querySelector('.filter-btn[data-filter="rating-4"]').textContent = `4 Sao (${data.rating_4 || 0})`;
                document.querySelector('.filter-btn[data-filter="rating-3"]').textContent = `3 Sao (${data.rating_3 || 0})`;
                document.querySelector('.filter-btn[data-filter="rating-2"]').textContent = `2 Sao (${data.rating_2 || 0})`;
                document.querySelector('.filter-btn[data-filter="rating-1"]').textContent = `1 Sao (${data.rating_1 || 0})`;
                document.querySelector('.filter-btn[data-filter="images"]').textContent = `Có Hình Ảnh / Video (${data.has_images})`;

                // Tính điểm đánh giá trung bình
                const totalPoints = (1 * data.rating_1) + (2 * data.rating_2) + (3 * data.rating_3) + (4 * data.rating_4) + (5 * data.rating_5);
                const ratingScore = (totalPoints / data.total_reviews).toFixed(1);
                document.querySelector('.rating-score').textContent = ratingScore;

                // Cập nhật hiển thị sao
                const stars = document.querySelectorAll('.stars-display .star');
                const fullStars = Math.floor(ratingScore);
                const halfStar = ratingScore % 1 >= 0.5 ? 1 : 0;

                stars.forEach((star, index) => {
                    star.classList.remove('filled', 'half');
                    if (index < fullStars) {
                        star.classList.add('filled');
                    } else if (index < fullStars + halfStar) {
                        star.classList.add('half');
                    }
                });
            })
            .catch(error => {
                console.error('Error fetching review summary:', error);
            });
    });
</script>