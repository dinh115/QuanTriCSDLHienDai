<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Thêm Sản Phẩm</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <h1>Thêm sản phẩm mới</h1>
  <form action="/products" method="POST" enctype="multipart/form-data">
    
    <!-- Ảnh sản phẩm -->
    <div>
      <label>Hình ảnh sản phẩm:</label>
      <input type="file" name="images" multiple accept="image/*">
    </div>

    <!-- Tên sản phẩm -->
    <div>
      <label>Tên sản phẩm:</label>
      <input type="text" name="name" maxlength="120" required>
    </div>

    <!-- Ngành hàng -->
    <div>
      <label>Ngành hàng:</label>
      <input type="text" name="category" placeholder="VD: Thời Trang Nam > Áo > Áo Len" required>
    </div>

    <!-- Mô tả -->
    <div>
      <label>Mô tả:</label>
      <textarea name="description" rows="5" maxlength="3000"></textarea>
    </div>

    <!-- Thông tin chi tiết -->
    <fieldset>
      <legend>Thông tin chi tiết</legend>
      <label>Thương hiệu:</label>
      <input type="text" name="brand"><br>

      <label>Xuất xứ:</label>
      <input type="text" name="origin"><br>

      <label>Chất liệu:</label>
      <input type="text" name="material"><br>

      <label>Mẫu:</label>
      <input type="text" name="model"><br>

      <label>Mùa:</label>
      <input type="text" name="season"><br>

      <label>Chiều dài áo:</label>
      <input type="text" name="shirt_length"><br>
    </fieldset>

    <!-- Thông tin bán hàng -->
    <fieldset>
      <legend>Thông tin bán hàng</legend>
      <label>Giá:</label>
      <input type="number" name="price" required><br>

      <label>Kho hàng:</label>
      <input type="number" name="stock" required><br>

      <label>Phân loại hàng:</label>
      <input type="text" name="variants" placeholder="VD: Size: S, M, L"><br>
    </fieldset>

    <!-- Vận chuyển -->
    <fieldset>
      <legend>Thông tin vận chuyển</legend>
      <label>Cân nặng (gram):</label>
      <input type="number" name="weight"><br>

      <label>Kích thước đóng gói (D x R x C cm):</label>
      <input type="number" name="length" placeholder="D">
      <input type="number" name="width" placeholder="R">
      <input type="number" name="height" placeholder="C">
    </fieldset>

    <!-- Thông tin khác -->
    <fieldset>
      <legend>Thông tin khác</legend>
      <label>SKU sản phẩm:</label>
      <input type="text" name="sku"><br>

      <label>Tình trạng:</label>
      <select name="condition">
        <option value="new">Mới</option>
        <option value="used">Đã qua sử dụng</option>
      </select>
    </fieldset>

    <button type="submit">Lưu sản phẩm</button>
  </form>
</body>
</html>

<script>
  document.getElementById("addProductForm").addEventListener("submit", async function (e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);

    const response = await fetch("http://product_service:3001/products", {
      method: "POST",
      body: formData
    });

    const result = await response.json();
    if (result.success) {
      alert("✅ Thêm sản phẩm thành công!");
      window.location.href = "/";
    } else {
      alert("❌ Lỗi khi thêm sản phẩm!");
    }
  });
</script>

