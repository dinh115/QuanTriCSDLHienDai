<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Shopee Clone - Đăng nhập</title>
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
            rel="stylesheet">
        <link rel="stylesheet" href="styles/login.css">
    </head>
    <body>
        <div class="login-modal" id="loginModal">
            <form class="login-form" id="loginForm" method="POST"
                action="/login">
                <h3 class="text-center mb-4">Đăng nhập</h3>

                <div class="form-group">
                    <input type="username" class="form-control" id="username"
                        placeholder="Tên người dùng" name="username" required>
                </div>

                <div class="form-group">
                    <input type="password" class="form-control" id="password"
                        placeholder="Mật khẩu" name="password" required>
                </div>

                <button type="submit" class="btn-login" id="submitLogin">
                    <span id="loginButtonText">Đăng nhập</span>
                </button>
                <% if (error) { %>
                <div id="errorMessage" class="error-message"><%= error %></div>
                <% } %>
            </form>
        </div>
    </body>
</html>